# Salin ke .env.local dan isi di lingkungan masing-masing. Jangan commit.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# dev, staging, atau production; demo hanya untuk dev lokal terisolasi.
MADEVI_ENV=dev
MADEVI_DEMO_MODE=false
DEMO_PASSWORD=
# Hanya saat bootstrap admin. Isi password minimal 12 karakter melalui environment privat.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Isi kelima nilai untuk pendaftaran, verifikasi, pergantian email, dan reset kata sandi.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Google OAuth opsional. Harus menambahkan redirect URI pada konsol Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# postgres adalah adapter lokal awal. Provider eksternal belum disediakan.
MEDIA_BACKEND=postgres
# Aktifkan setelah origin ditutup dan proxy menimpa kedua header yang didokumentasikan.
# Buat secret tersendiri minimal 32 karakter. Pasang nilai yang sama pada aplikasi dan proxy.
TRUST_PROXY_HEADERS=false
MADEVI_PROXY_SECRET=

# Hanya pada host operasi. Direktori absolut privat (0700), di luar checkout.
MADEVI_BACKUP_DIR=
# 32 byte acak dalam 64 karakter hex. Simpan di pengelola secret.
MADEVI_BACKUP_KEY=
# Opsional: role baca backup di endpoint dan database DATABASE_URL yang sama.
MADEVI_BACKUP_DATABASE_URL=
# Isi sementara saat restore ke database baru dan kosong madevi_restore_*.
MADEVI_RESTORE_DATABASE_URL=

# Hanya pada worker host untuk rollback Compose. Katalog privat dengan pilihan lokal.
MADEVI_HOST_CATALOG=
# Hanya pada proses web. Mount baca-saja direktori arsip terenkripsi untuk unduhan.
MADEVI_BACKUP_DOWNLOAD_DIR=

# Khusus proses host operasi. Lihat ops/systemd/README.md sebelum memasangnya.
# 0 menonaktifkan backup rutin. Gunakan jumlah jam (misalnya 24) saat sudah diuji.
MADEVI_ROUTINE_BACKUP_HOURS=0
MADEVI_MAINTENANCE_MODE=dry-run
MADEVI_MAINTENANCE_BATCH=500
MADEVI_RATE_RETENTION_DAYS=7
MADEVI_METRICS_RETENTION_DAYS=7
MADEVI_BACKUP_RETENTION_DAYS=30
# Isi alamat penerima tunggal dan direktori 0700 hanya saat alarm boleh mengirim.
MADEVI_ALERT_TO=
MADEVI_OPS_STATE_DIR=
MADEVI_ALERT_FAILURES=3
MADEVI_ALERT_REPEAT_MINUTES=360
MADEVI_ALERT_MAX_REPEATS=2
MADEVI_ALERT_DISK_FREE_PERCENT=10
