# Salin ke .env.local dan isi di lingkungan masing-masing. Jangan commit.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# dev, staging, atau production; demo hanya untuk dev lokal terisolasi.
MADEVI_ENV=dev
MADEVI_DEMO_MODE=false
DEMO_PASSWORD=
# Hanya saat bootstrap admin. Isi password minimal 12 karakter melalui environment privat.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Isi kelima nilai untuk pendaftaran, verifikasi, pergantian email, dan reset kata sandi.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Google OAuth opsional. Harus menambahkan redirect URI pada konsol Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# postgres adalah adapter lokal awal. Provider eksternal belum disediakan.
MEDIA_BACKEND=postgres
# Aktifkan setelah origin ditutup dan proxy menimpa kedua header yang didokumentasikan.
# Buat secret tersendiri minimal 32 karakter. Pasang nilai yang sama pada aplikasi dan proxy.
TRUST_PROXY_HEADERS=false
MADEVI_PROXY_SECRET=
