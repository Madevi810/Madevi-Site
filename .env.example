# Salin ke .env.local dan isi di lingkungan masing-masing. Jangan commit.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# dev, staging, atau production; demo hanya untuk dev lokal terisolasi.
MADEVI_ENV=dev
MADEVI_DEMO_MODE=false
DEMO_PASSWORD=
# Hanya dipakai sekali saat membuat admin non-demo. Simpan secara aman.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=
# Konfigurasi SMTP diperlukan untuk pendaftaran/verifikasi pengguna biasa.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Google OAuth opsional. Harus menambahkan redirect URI pada konsol Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# postgres adalah adapter lokal awal. Provider eksternal belum disediakan.
MEDIA_BACKEND=postgres
# Hanya aktifkan bila origin tidak dapat diakses langsung dan proxy tepercaya membersihkan header ini.
TRUST_PROXY_HEADERS=false


# Slot cadangan; belum dipakai kode aplikasi.
CACHE_URL=
STORAGE_URL=
LOG_LEVEL=
BACKUP_DIR=
