{
  "name": "madevi-platform",
  "type": "module",
  "version": "0.0.0-16",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:rollback:test": "node --env-file-if-exists=.env.local scripts/migrate.mjs --down",
    "db:seed-demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "db:create-owner": "node --env-file-if-exists=.env.local scripts/create-owner.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "test:integration": "node scripts/test-db-local.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pglite-server": "0.1.5",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
